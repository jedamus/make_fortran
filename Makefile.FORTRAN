# $(echo "test $(SRCDIR)")

ifeq ($(PLATFORM), windows)
  FC		:= x86_64-w64-mingw32-gfortran
  AR		:= x86_64-w64-mingw32-ar
  EXT		:= .exe
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
else ifeq ($(PLATFORM),macos)
  FC		:= mpifort
  AR		:= ar
  EXT		:= 
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
else
  FC		:= gfortran
  AR		:= ar
  EXT		:= 
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
endif

RANLIB		:= ranlib
LD		:= ld
AS		:= as

COMPILE.f	= $(FC) $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE.F	= $(FC) -cpp $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_SHARED.f = $(FC) -fPIC $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_SHARED.F = $(FC) -fPIC -cpp $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
LINK_SHARED_LIB = $(FC) -shared $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH))
DEPEND.f	= $(FC) -M $(strip $(DEFINES) $(MODFLAG))
#DEPEND.f	= $(FC) -M $(strip $(DEFINES) $(MODFLAG) $(FINCLUDES))
DEPEND.F	= $(FC) -cpp -M $(strip $(DEFINES) $(MODFLAG))
#DEPEND.F	= $(FC) -cpp -M $(strip $(DEFINES) $(MODFLAG) $(FINCLUDES))

define compile.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE.f) $< -o $@
endef

define compile.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE.F) $< -o $@
endef

define compile_shared.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_SHARED.f) $< -o $@
endef

define compile_shared.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_SHARED.F) $< -o $@
endef

define create-shared-lib
$(RM) $@
$(LINK_SHARED_LIB) -o $@ $^
endef

define depend.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.o $@ \2 |g' > $@
endef

define depend.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.o $@ \2 |g' > $@
endef

ifeq ($(link_switch),static)
define create-lib-rule
$$(BUILDLIB)/lib$(1).a: $$(wildcard $$(BUILDLIB)/$(1)/*.ol)
	$$(AR) rcs $$@ $$^
	$$(RANLIB) $$@
endef
else
define create-lib-rule
$$(BUILDLIB)/lib$(1).so: $$(wildcard $$(BUILDLIB)/$(1)/*.osl)
	$$(create-shared-lib)
endef
endif

# .o object files

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.for
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FOR
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.ftn
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FTN
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FPP
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f77
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F77
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f90
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F90
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f95
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F95
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f03
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F03
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f08
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F08
		    $(compile.F)

# .ol object files

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.for
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.FOR
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.ftn
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.FTN
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.FPP
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f77
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F77
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f90
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F90
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f95
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F95
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f03
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F03
		    $(compile.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f08
		    $(compile.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F08
		    $(compile.F)

# .osl object files

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.for
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FOR
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.ftn
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FTN
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FPP
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f77
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F77
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f90
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F90
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f95
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F95
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f03
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F03
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f08
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F08
		    $(compile_shared.F)

# dependencies

$(BUILDDIR)/%.d:    $(SRCDIR)/%.f
