# $(echo "test $(SRCDIR)")

ifeq ($(PLATFORM), windows)
  FC		:= x86_64-w64-mingw32-gfortran
  AR		:= x86_64-w64-mingw32-ar
  EXT		:= .exe
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
else ifeq ($(PLATFORM),macos)
  FC		:= mpifort
  AR		:= ar
  EXT		:= 
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
else
  FC		:= gfortran
  AR		:= ar
  EXT		:= 
  RM		:= rm -f
  MKDIR		:= mkdir -p
  FIND		:= find
endif

RANLIB		:= ranlib
LD		:= ld
AS		:= as

COMPILE.f	= $(FC) $(strip $(FFLAGS) $(DEFINES) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE.F	= $(FC) -cpp $(strip $(FFLAGS) $(DEFINES) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_STATIC.f = $(FC) $(strip $(FFLAGS) -DIS_LIB $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_STATIC.F = $(FC) -cpp $(strip $(FFLAGS) -DIS_LIB $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_SHARED.f = $(FC) -fPIC $(strip $(FFLAGS) -DIS_LIB $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
COMPILE_SHARED.F = $(FC) -fPIC -cpp $(strip $(FFLAGS) -DIS_LIB $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH)) -c
LINK_SHARED_LIB = $(FC) -shared $(strip $(FFLAGS) $(MODFLAG) $(FINCLUDES) $(TARGET_ARCH))
DEPEND.f.o	= $(FC) -M $(strip $(DEFINES) $(MODFLAG))
#DEPEND.f.o	= $(FC) -M $(strip $(DEFINES) $(MODFLAG) $(FINCLUDES))
DEPEND.F.o	= $(FC) -cpp -M $(strip $(DEFINES) $(MODFLAG))
#DEPEND.F.o	= $(FC) -cpp -M $(strip $(DEFINES) $(MODFLAG) $(FINCLUDES))
DEPEND.f.ol	= $(FC) -M $(strip $(DEFINES) -DIS_LIB $(MODFLAG)) 
DEPEND.F.ol	= $(FC) -cpp -M $(strip $(DEFINES) -DIS_LIB $(MODFLAG))
DEPEND.f.osl	= $(FC) -M $(strip $(DEFINES) -DIS_LIB $(MODFLAG))
DEPEND.F.osl	= $(FC) -cpp -M $(strip $(DEFINES) -DIS_LIB $(MODFLAG))
PRAE_T.f	= $(FC) -cpp -E $(strip $(DEFINES) -DIS_LIB
PRAE_T.F	= $(FC) -cpp -E $(strip $(DEFINES) -DIS_LIB

define compile.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE.f) $< -o $@
endef

define compile.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE.F) $< -o $@
endef

define compile_static.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_STATIC.f) $< -o $@
endef

define compile_static.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_STATIC.F) $< -o $@
endef

define compile_shared.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_SHARED.f) $< -o $@
endef

define compile_shared.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(COMPILE_SHARED.F) $< -o $@
endef

define create-shared-lib
$(RM) $@
$(LINK_SHARED_LIB) -o $@ $^
endef

define depend.f.o
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.o) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.o $(dir $@)\1.t $@ \2 |g' > $@
endef

define depend.F.o
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.o) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.o $(dir $@)\1.t $@ \2 |g' > $@
endef

define depend.f.ol
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.ol) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.ol $(dir $@)\1.t $@ \2 |g' > $@
endef

define depend.F.ol
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.ol) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.ol $(dir $@)\1.t $@ \2 |g' > $@
endef

define depend.f.osl
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.osl) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.osl $(dir $@)\1.t $@ \2 |g' > $@
endef

define depend.F.osl
$(RM) $@
@$(MKDIR) $(dir $@)
$(DEPEND.F.osl) $< | sed 's|\(.*\)\.o\([ :]*\)|$(dir $@)\1.osl $(dir $@)\1.t $@ \2 |g' > $@
endef

define prae_t.f
$(RM) $@
@$(MKDIR) $(dir $@)
$(PRAE_T.f) $<  > $@
endef

define prae_t.F
$(RM) $@
@$(MKDIR) $(dir $@)
$(PRAE_T.F) $<  > $@
endef

ifeq ($(link_switch),static)
define create-lib-rule
$$(BUILDLIB)/lib$(1).a: $$(wildcard $$(BUILDLIB)/$(1)/*.ol)
	$$(AR) rcs $$@ $$^
	$$(RANLIB) $$@

endef
else
define create-lib-rule
$$(BUILDLIB)/lib$(1).so: $$(wildcard $$(BUILDLIB)/$(1)/*.osl)
	$$(create-shared-lib)

endef
endif

# .o object files

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.for
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FOR
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.ftn
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FTN
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.FPP
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f77
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F77
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f90
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F90
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f95
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F95
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f03
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F03
		    $(compile.F)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.f08
		    $(compile.f)

$(BUILDDIR)/%.o:    $(SRCDIR)/%.F08
		    $(compile.F)

# .ol object files

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f
		    $(compile_static.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F
		    $(compile_static.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.for
