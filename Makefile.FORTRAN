$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F03
		    $(compile_static.F)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.f08
		    $(compile_static.f)

$(BUILDDIR)/%.ol:   $(SRCDIR)/%.F08
		    $(compile_static.F)

# .osl object files

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.for
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FOR
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.ftn
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FTN
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.FPP
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f77
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F77
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f90
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F90
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f95
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F95
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f03
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F03
		    $(compile_shared.F)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.f08
		    $(compile_shared.f)

$(BUILDDIR)/%.osl:  $(SRCDIR)/%.F08
		    $(compile_shared.F)

