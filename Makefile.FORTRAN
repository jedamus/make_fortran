$(BUILDDIR)/%.d:    $(SRCDIR)/%.F
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.for
		    $(depend.f)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.FOR
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.ftn
		    $(depend.f)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.FTN
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.FPP
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.f77
		    $(depend.f)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.F77
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.f90
		    $(depend.f)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.F90
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.f95
		    $(depend.f)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.F95
		    $(depend.F)

$(BUILDDIR)/%.d:    $(SRCDIR)/%.f03
