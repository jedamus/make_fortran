%.osl:		%.c
		$(library_compile.c)

%.ol:		%.c
		$(library_compile.c)

%.so:		%.ol
		$(dynamic_library.ol)

%.so:		%.osl
		$(dynamic_library.osl)

%.ol:		%.cc
		$(library_compile.cc)

%.osl:		%.cc
		$(library_compile.cc)

%.osl:		%.c++
		$(library_compile.cc)

%.osl:		%.cpp
		$(library_compile.cc)

%.osl:		%.cxx
		$(library_compile.cc)

%.osl:		%.C
		$(library_compile.cc)

